# ---------------------------------------------------------------------------
# VerseFlow environment
#
# Every value here is optional. With none of them set the app runs against the
# local settlement simulation and the deterministic agreement engine, which is
# the intended zero-setup path.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file. Use :memory: for an ephemeral database.
VERSEFLOW_DB_PATH=./data/verseflow.db

# --- Settlement ------------------------------------------------------------
# "simulated" (default) runs the local settlement simulation.
# "live" requires BOTH VERSE_RPC_URL and VERSE_ESCROW_ADDRESS; if either is
# missing the app stays simulated rather than reporting fake confirmations.
NEXT_PUBLIC_SETTLEMENT_MODE=simulated

NEXT_PUBLIC_VERSE_CHAIN_ID=20197
NEXT_PUBLIC_VERSE_CHAIN_NAME=Verse
NEXT_PUBLIC_VERSE_CURRENCY_SYMBOL=OAS
NEXT_PUBLIC_VERSE_EXPLORER_URL=https://explorer.verse.example
NEXT_PUBLIC_VERSE_TESTNET=false

# Server-side RPC endpoint for reading receipts and escrow state.
VERSE_RPC_URL=

# Deployed VerseFlowEscrow address (see contracts/VerseFlowEscrow.sol).
VERSE_ESCROW_ADDRESS=

# Confirmations required before a payment is treated as settled.
VERSE_CONFIRMATIONS=1

# ERC-20 settlement assets on Verse. Leave blank to settle in the native coin.
NEXT_PUBLIC_VERSE_USDC_ADDRESS=
NEXT_PUBLIC_VERSE_EURC_ADDRESS=

# Confirmation latency of the simulated settlement layer, in milliseconds.
SIMULATED_CONFIRM_MS=2200

# --- Verse App Analytics ---------------------------------------------------
# Without these, events are still recorded locally and drive the internal
# analytics console; they simply are not forwarded.
VERSE_ANALYTICS_ENDPOINT=
VERSE_ANALYTICS_APP_ID=
VERSE_ANALYTICS_API_KEY=

# --- Agreement engine ------------------------------------------------------
# Optional. Without a key the deterministic rule engine is used for both
# agreement generation and evidence analysis, and the UI labels which ran.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Operations ------------------------------------------------------------
# Allows POST /api/demo/reset outside development. Leave unset in production.
ALLOW_DEMO_RESET=
